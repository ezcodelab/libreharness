{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "permissions": [
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" }
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000
  },
  "mcp": {
    "servers": {
      "grep-app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  }
}
