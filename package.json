{
  "name": "libreharness",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/plugin.js"
  },
  "description": "A durable task queue and engineering workflow for OpenCode, as a plugin.",
  "homepage": "https://github.com/ezcodelab/libreharness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezcodelab/libreharness.git"
  },
  "bugs": {
    "url": "https://github.com/ezcodelab/libreharness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "src",
    "agents",
    "commands",
    "skills",
    "plugins",
    "bin/*.py",
    "docs/reference.md"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=20",
    "python": ">=3.10"
  },
  "scripts": {
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:node": "node tests/auto-intake.test.mjs && node tests/goal-watch.test.mjs && node tests/usage-ledger.test.mjs && node tests/structural.test.mjs && node tests/plugin.test.mjs && node tests/harness-ratchets.test.mjs",
    "test": "npm run test:python && npm run test:node",
    "lint:md": "npx --yes markdownlint-cli2@0.18.1 '**/*.md'"
  },
  "dependencies": {
    "@ast-grep/cli": "0.51.3",
    "@opencode/plugin": "^2.2.6"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.20"
  }
}
